# Browser-safe configuration
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_APP_ORIGIN=https://gnouht.space
# Leave this out to get the app's own two map styles (public/map, one for each look). Set it only
# to draw the map with another style, which then serves both looks.
# VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
VITE_WEB_PUSH_VAPID_PUBLIC_KEY=
# The Google OAuth client ID that the Supabase project uses. With it, Google sign-in returns straight
# to the app and Google's screen names the app's domain. Needs the app's address in the client's redirect URIs.
VITE_GOOGLE_CLIENT_ID=

# Server-only Edge Function secrets. Never expose these with a VITE_ prefix.
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_CONTACT=mailto:admin@gnouht.space
