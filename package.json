{
  "name": "gnouht-together",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "test": "node scripts/build-map-style.mjs --check && vitest run",
    "build:map": "node scripts/build-map-style.mjs",
    "test:db": "node scripts/db-smoke.mjs",
    "test:db:local": "node scripts/db-smoke.mjs --url postgresql://postgres:postgres@127.0.0.1:54322/postgres",
    "test:push:local": "node scripts/local-push-check.mjs",
    "preview": "vite preview",
    "deploy": "node scripts/deploy.mjs",
    "push:setup": "node scripts/setup-push.mjs",
    "test:e2e": "playwright test",
    "test:e2e:preview": "E2E_PREVIEW=1 playwright test"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.23",
    "@supabase/supabase-js": "2.117.2",
    "@tanstack/react-query": "5.104.1",
    "ical.js": "^2.2.1",
    "lucide-react": "1.52.0",
    "maplibre-gl": "6.11.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "temporal-polyfill": "1.0.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.1.1",
    "pg": "^8.23.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "^4.0.0"
  }
}
