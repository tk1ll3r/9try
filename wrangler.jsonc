{
  // Cloudflare serves the static app and counts requests; the app backend remains Supabase.
  // Deploy with `npm run deploy` after `npx wrangler login`.
  "name": "gnouht-together",
  "compatibility_date": "2026-09-01",
  "main": "./worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Run the small request counter before serving assets. Its durable write is scheduled in the background.
    "run_worker_first": true,
    // The app routes in the browser, so an address such as /calendar is answered with index.html.
    "not_found_handling": "single-page-application"
  },
  "durable_objects": {
    "bindings": [{ "name": "PUBLIC_REQUESTS", "class_name": "PublicRequestCounter" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PublicRequestCounter"] }],
  // Reachable at its own host only, not at a workers.dev address.
  "workers_dev": false,
  "preview_urls": false,
  // Creates the DNS record and the certificate for this one host. Other records of the zone are not touched.
  "routes": [{ "pattern": "9try.gnouht.space", "custom_domain": true }]
}
